    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eas-build-cache-provider": "^20.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "expo-mcp": "~0.2.1",
    "firebase-admin": "14.5.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "tsx": "^4.20.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "doppler run -- expo start",
    "start:dev-client": "doppler run -- expo start --dev-client --lan --port 8083",
    "start:dev-client:personal-team": "doppler run -- env EXPO_PUBLIC_APP_ENV=development EXPO_PUBLIC_IOS_PERSONAL_TEAM_BUILD=1 expo start --dev-client --lan --port 8083",
    "prebuild:ios:personal-team": "doppler run -- env EXPO_PUBLIC_APP_ENV=development EXPO_PUBLIC_IOS_PERSONAL_TEAM_BUILD=1 expo prebuild --clean --platform ios",
    "ios:device:personal-team": "doppler run -- env EXPO_PUBLIC_APP_ENV=development EXPO_PUBLIC_IOS_PERSONAL_TEAM_BUILD=1 expo run:ios --device --port 8083",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:play:internal": "eas build --profile internal --platform android",
    "build:play:beta": "eas build --profile beta --platform android",
    "build:play:closed": "eas build --profile closed --platform android",
    "release:play:internal": "eas build --profile internal --platform android --auto-submit",
    "release:play:beta": "eas build --profile beta --platform android --auto-submit",
    "release:play:closed": "eas build --profile closed --platform android --auto-submit",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "doppler run -- expo run:android",
    "ios": "doppler run -- expo run:ios",
    "prebuild": "doppler run -- expo prebuild",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest",
    "test:rules": "node scripts/test-firestore-rules.mjs",
    "test:rules:emulator": "firebase emulators:exec --only firestore --project demo-gemfort \"node --test scripts/test-firestore-rules-emulator.mjs\"",
    "test:service-emulator": "firebase emulators:exec --only firestore --project demo-gemfort \"node scripts/test-service-cancellation-emulator.cjs\"",
    "test:ap-emulator": "firebase emulators:exec --only firestore --project demo-gemfort \"node scripts/test-ap-cancellation-emulator.cjs\"",
    "test:ap-sale-emulator": "firebase emulators:exec --only firestore --project demo-gemfort \"node scripts/test-ap-sale-emulator.cjs\"",
    "test:ap-payment-emulator": "firebase emulators:exec --only firestore --project demo-gemfort \"node scripts/test-ap-payment-emulator.cjs\"",
    "test:account-wipe-emulator": "firebase emulators:exec --only firestore,storage --project demo-gemfort \"node scripts/test-account-wipe-emulator.cjs\"",
    "test:functions": "npm --prefix functions run test",
    "seed": "doppler run -- npx tsx scripts/seed-marketplace.ts",
    "seed:admin": "node scripts/seed-admin.mjs",
    "seed:qa": "node scripts/seed-qa.mjs",
    "update:dev": "eas update --channel development --environment development",
    "update:preview": "eas update --channel preview --environment preview",
    "update:play:internal": "eas update --channel internal --environment preview",
    "update:play:beta": "eas update --channel beta --environment preview",
    "update:play:closed": "eas update --channel closed --environment preview",
    "firebase:deploy": "firebase deploy --only firestore:rules,firestore:indexes,storage,functions",
    "firebase:sync": "node scripts/sync-firebase-native-configs.mjs",
    "firebase:sync:eas": "node scripts/sync-firebase-native-configs.mjs --upload-eas"
  },
  "private": true,
  "trustedDependencies": [
    "@shopify/react-native-skia"
  ],
  "patchedDependencies": {
    "react-native-graph@1.3.0": "patches/react-native-graph@1.3.0.patch"
  }
}
