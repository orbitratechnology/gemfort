  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client --lan --port 8083",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:play:internal": "eas build --profile internal --platform android",
    "build:play:beta": "eas build --profile beta --platform android",
    "build:play:closed": "eas build --profile closed --platform android",
    "release:play:internal": "eas build --profile internal --platform android --auto-submit",
    "release:play:beta": "eas build --profile beta --platform android --auto-submit",
    "release:play:closed": "eas build --profile closed --platform android --auto-submit",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest",
    "test:rules": "node scripts/test-firestore-rules.mjs",
    "test:service-emulator": "firebase emulators:exec --only firestore \"node scripts/test-service-cancellation-emulator.cjs\"",
    "test:ap-emulator": "firebase emulators:exec --only firestore \"node scripts/test-ap-cancellation-emulator.cjs\"",
    "test:ap-sale-emulator": "firebase emulators:exec --only firestore \"node scripts/test-ap-sale-emulator.cjs\"",
    "test:ap-payment-emulator": "firebase emulators:exec --only firestore \"node scripts/test-ap-payment-emulator.cjs\"",
    "test:functions": "npm --prefix functions run test",
    "seed": "npx tsx scripts/seed-marketplace.ts",
    "seed:admin": "node scripts/seed-admin.mjs",
    "seed:qa": "node scripts/seed-qa.mjs",
    "update:dev": "eas update --channel development --environment development",
    "update:preview": "eas update --channel preview --environment preview",
    "update:play:internal": "eas update --channel internal --environment preview",
    "update:play:beta": "eas update --channel beta --environment preview",
    "update:play:closed": "eas update --channel closed --environment preview",
    "firebase:deploy": "firebase deploy --only firestore:rules,firestore:indexes,storage,functions",
    "firebase:sync": "node scripts/sync-firebase-native-configs.mjs",
    "firebase:sync:eas": "node scripts/sync-firebase-native-configs.mjs --upload-eas"
  },
  "private": true,
  "overrides": {
    "react-native-screens": "~4.26.0"
  }
