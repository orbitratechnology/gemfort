{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "bun": "1.4.2",
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development"
      },
      "ios": {
        "simulator": true
      }
    },
    "canary": {
      "bun": "1.4.2",
      "extends": "development",
      "channel": "canary",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_GEMFORT_API_BASE_URL": "https://asia-south1-gemfort.cloudfunctions.net/gemfortApi"
      }
    },
    "ap-canary": {
      "bun": "1.4.2",
      "extends": "canary",
      "channel": "ap-canary",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development"
      }
    },
    "preview": {
      "bun": "1.4.2",
      "environment": "preview",
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview"
      },
      "ios": {
        "simulator": true
      }
    },
    "internal": {
      "bun": "1.4.2",
      "environment": "preview",
      "distribution": "store",
      "autoIncrement": true,
      "channel": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "beta": {
      "bun": "1.4.2",
      "extends": "internal",
      "channel": "beta"
    },
    "closed": {
      "bun": "1.4.2",
      "extends": "internal",
      "channel": "closed"
    },
    "production": {
      "bun": "1.4.2",
      "environment": "production",
      "distribution": "store",
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_GEMFORT_API_BASE_URL": "https://asia-south1-gemfort.cloudfunctions.net/gemfortApi",
        "EXPO_PUBLIC_GEMFORT_API_CANARY": "false",
        "EXPO_PUBLIC_GEMFORT_AP_API_CANARY": "false"
      }
    },
    "production-apk": {
      "bun": "1.4.2",
      "environment": "production",
      "distribution": "internal",
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_GEMFORT_API_BASE_URL": "https://asia-south1-gemfort.cloudfunctions.net/gemfortApi",
        "EXPO_PUBLIC_GEMFORT_API_CANARY": "false",
        "EXPO_PUBLIC_GEMFORT_AP_API_CANARY": "false"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {},
    "preview": {},
    "internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "beta": {
      "android": {
        "track": "beta",
        "releaseStatus": "completed"
      }
    },
    "closed": {
      "android": {
        "track": "alpha",
        "releaseStatus": "completed"
      }
    }
  }
}
