rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════
    // HELPER FUNCTIONS
    // ═══════════════════════════════════════════════

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isOwner(ownerUid) {
      return isSignedIn() && uid() == ownerUid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function isNotSuspended() {
      // Prefer != true so missing/null isSuspended does not deny legitimate writes.
      return getUserData().get('isSuspended', false) != true;
    }

    function resourceNotSuspended() {
      return resource.data.get('isSuspended', false) != true;
    }

    function validCheque(data) {
      return data.amount is number
        && data.amount > 0
        && data.direction in ['received', 'given']
        && data.status in ['holding', 'deposited', 'cleared', 'bounced', 'replaced', 'cancelled'];
    }

    function validChequeStatusTransition(before, after) {
      return before == after
        || (before == 'holding'
            && after in ['deposited', 'cleared', 'bounced', 'replaced', 'cancelled'])
        || (before == 'deposited'
            && after in ['cleared', 'bounced', 'replaced', 'cancelled'])
        || (before == 'bounced' && after == 'replaced');
    }

    function validBill(data) {
      return data.amount is number
        && data.amount > 0
        && data.amountSettled is number
        && data.amountSettled >= 0
        && data.amountSettled <= data.amount
        && data.direction in ['payable', 'receivable']
        && data.status in ['open', 'ongoing', 'partial', 'paid', 'cancelled', 'overdue']
        && (data.status != 'paid' || data.amountSettled == data.amount)
        && (data.status != 'partial'
            || (data.amountSettled > 0 && data.amountSettled < data.amount))
        && ((data.status != 'open' && data.status != 'ongoing')
            || data.amountSettled == 0);
    }

    function validBillStatusTransition(before, after) {
      return before == after
        || (before in ['open', 'ongoing', 'overdue']
            && after in ['open', 'ongoing', 'partial', 'paid', 'cancelled', 'overdue'])
        || (before == 'partial' && after in ['partial', 'paid', 'cancelled', 'overdue']);
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin' && isNotSuspended();
    }

    function isVerifiedTrader() {
      return isSignedIn()
        && (getUserRole() == 'trader' || getUserRole() == 'verified_seller')
        && getUserData().verificationStatus == 'verified'
        && isNotSuspended();
    }

    function isVerifiedLapidary() {
      return isSignedIn()
        && (getUserRole() == 'lapidary' || getUserRole() == 'verified_provider')
        && getUserData().verificationStatus == 'verified'
        && isNotSuspended();
    }

    // Legacy aliases
    function isVerifiedSeller() {
      return isVerifiedTrader();
    }

    function isVerifiedProvider() {
      return isVerifiedLapidary();
    }

    function isVerifiedMember() {
      return isVerifiedTrader() || isVerifiedLapidary();
    }

    function isAnySignedIn() {
      return isSignedIn() && isNotSuspended();
    }

    function isBusinessOwner(businessData) {
      return isSignedIn() && uid() == businessData.ownerUid;
    }

    function isGemOwner(gemData) {
      return isSignedIn() && uid() == gemData.ownerUid;
    }

    // Fields that only admin can change on businesses
    function isProtectedBusinessField(fieldName) {
      return fieldName in [
        'verificationStatus', 'verificationTier',
        'verifiedAt', 'verifiedByAdminUid',
        'recognizedBadgeAssignedAt', 'recognizedBadgeAssignedByAdminUid',
        'isFeatured', 'featuredUntil', 'featuredByAdminUid',
        'badges.isVerified', 'badges.isNgjaRegistered',
        'analytics', 'isActive', 'subscriptionPlan',
        'subscriptionExpiry'
      ];
    }

    // ═══════════════════════════════════════════════
    // SYSTEM (FX cache — Admin SDK writes only)
    // ═══════════════════════════════════════════════

    match /system/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ═══════════════════════════════════════════════
    // USERS
    // ═══════════════════════════════════════════════

    match /users/{userId} {

      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.role in ['trader', 'lapidary']
        && request.resource.data.isSuspended == false
        && request.resource.data.verificationStatus == 'none'
        && request.resource.data.get('nicVerified', false) == false
        && request.resource.data.get('recognizedBadge', false) == false
        && request.resource.data.get('recognizedBadgeAssignedAt', null) == null
        && request.resource.data.get('recognizedBadgeAssignedByAdminUid', null) == null;

      // Push token / profile field updates — use resource.data (not get()) so
      // concurrent writes to the same user doc do not fail isNotSuspended().
      // Phone identity and verification state are server-owned after Firebase Auth verification.
      allow update: if isOwner(userId)
        && resourceNotSuspended()
        && !request.resource.data.diff(resource.data)
           .affectedKeys().hasAny([
             'role', 'verificationStatus', 'isSuspended',
             'isActive', 'suspendedReason', 'suspendedAt',
             'phone', 'phoneVerified',
             'nicVerified', 'recognizedBadge',
             'recognizedBadgeAssignedAt', 'recognizedBadgeAssignedByAdminUid'
           ]);

      // Narrow allow for FCM token registration (owner only).
      allow update: if isOwner(userId)
        && resourceNotSuspended()
        && request.resource.data.diff(resource.data)
           .affectedKeys().hasOnly(['fcmToken', 'updatedAt']);

      // Applicant may mark themselves pending after submitting verification.
      // Cannot set verified/revoked — those remain admin-only.
      // dateOfBirth is part of KYC and may be set with the pending transition.
      allow update: if isOwner(userId)
        && resourceNotSuspended()
        && request.resource.data.diff(resource.data)
           .affectedKeys().hasOnly(['verificationStatus', 'updatedAt', 'dateOfBirth'])
        && resource.data.verificationStatus in [
             'none', 'rejected', 'pending', 'info_requested', 'under_review'
           ]
        && request.resource.data.verificationStatus == 'pending'
        && request.resource.data.dateOfBirth is string
        && request.resource.data.dateOfBirth.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════
    // BUSINESSES
    // ═══════════════════════════════════════════════

    match /businesses/{businessId} {
      // Owner reads own (even pending / inactive)
      allow get, list: if isSignedIn()
                  && isBusinessOwner(resource.data);

      // Admin reads all
      allow get, list: if isAdmin();

      // Verified members can create business profile
      allow create: if isAnySignedIn()
        && isOwner(request.resource.data.ownerUid)
        && request.resource.data.verificationStatus == 'none'
        && request.resource.data.isActive == true
        && request.resource.data.isFeatured == false
        && request.resource.data.badges.isVerified == false
        && request.resource.data.badges.get('businessReputation', 'member') in ['none', 'member']
        // Accept both app generations during the Directory/Endorse migration.
        && request.resource.data.badges.get('likeCount', 0) == 0
        && request.resource.data.badges.get('endorsementCount', 0) == 0
        && request.resource.data.analytics.profileViewsTotal == 0;

      // Owner updates own (not protected fields)
      allow update: if isAnySignedIn()
        && isBusinessOwner(resource.data)
        && !request.resource.data.diff(resource.data)
           .affectedKeys().hasAny([
             'verificationStatus', 'verificationTier',
             'verifiedAt', 'verifiedByAdminUid',
             'recognizedBadgeAssignedAt', 'recognizedBadgeAssignedByAdminUid',
             'isFeatured', 'featuredUntil', 'featuredByAdminUid',
             'badges', 'analytics', 'isActive',
             'subscriptionPlan', 'subscriptionExpiry',
             'ownerUid'
           ]);

      // Admin controls all fields
      allow update: if isAdmin();

      // Guest/member analytics taps on public verified businesses (counters only)
      allow update: if resource.data.verificationStatus == 'verified'
        && resource.data.isActive == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['analytics', 'updatedAt']);

      allow delete: if isAdmin();
    }

    // Server-maintained allowlisted mirror for public directory/profile reads.
    // Clients cannot create, update, or delete projection documents.
    match /public_businesses/{businessId} {
      allow get, list: if resource.data.verificationStatus == 'verified'
                       && resource.data.isActive == true;
      allow create, update, delete: if false;
    }

    // ═══════════════════════════════════════════════
    // GEMS (GemNet listings)
    // ═══════════════════════════════════════════════

    match /gems/{gemId} {

      // Public listings — anyone
      allow read: if resource.data.status == 'active'
                  && resource.data.visibility == 'public';

      // Contacts listings — signed-in viewers only
      allow read: if resource.data.status == 'active'
                  && resource.data.visibility == 'contacts'
                  && isAnySignedIn();

      // Legacy private / members_only stay link-readable while active
      allow read: if resource.data.status == 'active'
                  && (resource.data.visibility == 'private'
                      || resource.data.visibility == 'members_only');

      // Owner reads all their own listings (incl. draft/paused/sold)
      allow read: if isOwner(resource.data.sellerUid);

      // Admin reads all
      allow read: if isAdmin();

      // Only verified traders create listings
      allow create: if isVerifiedTrader()
        && isOwner(request.resource.data.sellerUid)
        && request.resource.data.soldAt == null
        && request.resource.data.soldPrice == null
        && request.resource.data.analytics.totalViews == 0
        && request.resource.data.analytics.whatsappTaps == 0
        && request.resource.data.visibility in ['public', 'contacts'];

      // Owner updates own (analytics via Cloud Functions only)
      allow update: if isOwner(resource.data.sellerUid)
        && isNotSuspended()
        && !request.resource.data.diff(resource.data)
           .affectedKeys().hasAny([
             'analytics', 'shareableSlug', 'shareableUrl',
             'sellerUid', 'businessId'
           ]);

      allow delete: if isOwner(resource.data.sellerUid)
                    || isAdmin();
    }

    // ═══════════════════════════════════════════════
    // ANNOUNCEMENTS
    // ═══════════════════════════════════════════════

    match /announcements/{announcementId} {
      allow read: if resource.data.isVisible == true;
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════
    // GEM SHOWS (admin-managed public stories)
    // ═══════════════════════════════════════════════

    match /gem_shows/{showId} {
      allow read: if resource.data.isVisible == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════
    // ═══════════════════════════════════════════════
    // LIKES
    // ═══════════════════════════════════════════════

    match /likes/{likeId} {

      // Liker can read their own like (for Liked state). List stays admin-only.
      allow get: if isAdmin()
        || (isSignedIn() && resource.data.fromUid == request.auth.uid);
      allow list: if isAdmin();

      // Verified members can like others
      allow create: if isVerifiedMember()
        && isOwner(request.resource.data.fromUid)
        // Cannot like self
        && request.resource.data.fromBusinessId
           != request.resource.data.toBusinessId
        // Neither current nor legacy clients can create a duplicate.
        && !exists(/databases/$(database)/documents/likes/$(request.resource.data.fromBusinessId + '_' + request.resource.data.toBusinessId))
        && !exists(/databases/$(database)/documents/endorsements/$(request.resource.data.fromBusinessId + '_' + request.resource.data.toBusinessId));

      // Likes are permanent (no update or user delete)
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Temporary compatibility for installed clients that predate the Likes rename.
    match /endorsements/{endorsementId} {
      allow read: if isAdmin();
      allow create: if isVerifiedMember()
        && isOwner(request.resource.data.fromUid)
        && request.resource.data.fromBusinessId
           != request.resource.data.toBusinessId
        && !exists(/databases/$(database)/documents/endorsements/$(request.resource.data.fromBusinessId + '_' + request.resource.data.toBusinessId))
        && !exists(/databases/$(database)/documents/likes/$(request.resource.data.fromBusinessId + '_' + request.resource.data.toBusinessId));
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════
    // REPORTS
    // ═══════════════════════════════════════════════

    match /reports/{reportId} {
      allow read: if isOwner(resource.data.reporterUid);
      allow read: if isAdmin();

      allow create: if isAnySignedIn()
        && isOwner(request.resource.data.reporterUid)
        && request.resource.data.status == 'pending'
        && request.resource.data.adminUid == null;

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════
    // VERIFICATION APPLICATIONS
    // ═══════════════════════════════════════════════

    match /verification_applications/{appId} {
      allow read: if isOwner(resource.data.applicantUid);
      allow read: if isAdmin();

      // KYC: dateOfBirth (YYYY-MM-DD) + businessName are mandatory.
      allow create: if isAnySignedIn()
        && isOwner(request.resource.data.applicantUid)
        && request.resource.data.status == 'pending'
        && request.resource.data.adminUid == null
        && request.resource.data.dateOfBirth is string
        && request.resource.data.dateOfBirth.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.businessName is string
        && request.resource.data.businessName.size() >= 2
        && request.resource.data.businessName.size() <= 80
        && request.resource.data.documents is map
        && request.resource.data.documents.nicPhotoUrl is string
        && request.resource.data.documents.nicPhotoUrl.size() > 0;

      // Applicant can resubmit when info requested
      allow update: if isOwner(resource.data.applicantUid)
        && resource.data.status == 'info_requested'
        && !request.resource.data.diff(resource.data)
           .affectedKeys().hasAny([
             'status', 'adminUid', 'adminNotes',
             'rejectionReason', 'resolvedAt', 'reviewedAt'
           ])
        && request.resource.data.dateOfBirth is string
        && request.resource.data.dateOfBirth.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.businessName is string
        && request.resource.data.businessName.size() >= 2
        && request.resource.data.businessName.size() <= 80
        && request.resource.data.documents is map
        && request.resource.data.documents.nicPhotoUrl is string
        && request.resource.data.documents.nicPhotoUrl.size() > 0;

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════
    // NOTIFICATIONS
    // ═══════════════════════════════════════════════

    match /notifications/{notifId} {
      allow read: if isOwner(resource.data.recipientUid);

      // User can only mark as read
      allow update: if isOwner(resource.data.recipientUid)
        && request.resource.data.diff(resource.data)
           .affectedKeys().hasOnly(['isRead']);

      // Notifications are server-owned. Cloud Functions use the Admin SDK,
      // so client writes must not be able to impersonate another user's alerts.
      allow create: if isAdmin();
      allow delete: if isOwner(resource.data.recipientUid)
                    || isAdmin();
    }

    // ═══════════════════════════════════════════════
    // LISTING OFFERS (GemNet price offers)
    // ═══════════════════════════════════════════════

    match /listing_offers/{offerId} {
      allow read: if isSignedIn()
        && (resource.data.buyerUid == uid()
            || resource.data.sellerUid == uid()
            || isAdmin());

      // Offer creation is server-owned so per-listing cooldown and daily
      // limits cannot be bypassed with a direct client write.
      allow create: if isAdmin();

      // Buyer: withdraw. Seller: mark read / clear. Admin: any.
      allow update: if isSignedIn()
        && (
          (
            resource.data.buyerUid == uid()
            && resource.data.status == 'pending'
            && request.resource.data.status == 'withdrawn'
            && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['status', 'updatedAt'])
          )
          || (
            resource.data.sellerUid == uid()
            && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['sellerCleared', 'sellerReadAt', 'updatedAt'])
          )
          || isAdmin()
        );

      // Buyer may delete own pending/withdrawn offer; seller may remove received offers.
      allow delete: if isSignedIn()
        && (
          (resource.data.buyerUid == uid()
            && resource.data.status in ['pending', 'withdrawn'])
          || resource.data.sellerUid == uid()
          || isAdmin()
        );
    }

    // ═══════════════════════════════════════════════
    // SERVICE REQUESTS
    // ═══════════════════════════════════════════════

    match /service_requests/{id} {
      allow read: if isSignedIn()
        && (resource.data.traderUid == uid() || resource.data.lapidaryUid == uid() || isAdmin());
      allow create: if isVerifiedTrader()
        && request.resource.data.traderUid == uid()
        && request.resource.data.status == 'pending';
      allow update: if isSignedIn()
        && (resource.data.lapidaryUid == uid() || resource.data.traderUid == uid() || isAdmin());
      allow delete: if isAdmin();
    }

    match /lapidary_jobs/{id} {
      allow read: if isSignedIn()
        && (resource.data.lapidaryUid == uid() || resource.data.traderUid == uid() || isAdmin());
      allow create: if isVerifiedLapidary()
        && request.resource.data.lapidaryUid == uid();
      allow update: if isSignedIn()
        && (resource.data.lapidaryUid == uid() || isAdmin());
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════
    // ADMIN ACTIONS (immutable audit log)
    // ═══════════════════════════════════════════════

    match /admin_actions/{actionId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      // Immutable — no updates or deletes ever
      allow update: if false;
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════
    // GEMTRACK — ALL COLLECTIONS ARE PRIVATE
    // Pattern: ownerUid must match auth uid
    // ═══════════════════════════════════════════════

    match /gemtrack_gems/{docId} {
      allow read: if isOwner(resource.data.ownerUid)
                  && isNotSuspended();
      // Ordinary owner edits remain supported, but ownership and sale state
      // are server-owned so a client cannot bypass the recipient acceptance
      // flow by writing sold/owner fields directly.
      allow update: if isOwner(resource.data.ownerUid)
        && isNotSuspended()
        && resource.data.get('currentApId', null) == null
        && resource.data.get('status', '') != 'on_ap'
        && resource.data.get('custody', null) != 'on_ap'
        && request.resource.data.ownerUid == resource.data.ownerUid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'ownerUid',
          'currentApId', 'currentHolderContactId',
          'saleTransferRequestId', 'saleStatus',
          'soldPrice', 'soldPriceCurrency', 'soldPriceBase', 'soldDate',
          'soldToUid', 'soldToBusinessId', 'soldToContactId', 'soldToName',
          'salePaymentMethod',
          'acquiredFromUid', 'acquiredAt',
          'lastSaleRequestId', 'lastSoldPrice', 'lastSoldPriceCurrency',
          'lastSalePaymentMethod',
          'outcome'
        ]);
      // Market listing is an owner action, but it cannot be used to alter a
      // transfer, move a gem into custody, or manufacture a sold state.
      allow update: if isOwner(resource.data.ownerUid)
        && isNotSuspended()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && resource.data.get('custody', null) == null
        && resource.data.get('currentApId', null) == null
        && resource.data.get('currentHolderContactId', null) == null
        && request.resource.data.get('custody', null) == resource.data.get('custody', null)
        && request.resource.data.get('currentApId', null) == resource.data.get('currentApId', null)
        && request.resource.data.get('currentHolderContactId', null) == resource.data.get('currentHolderContactId', null)
        && request.resource.data.get('saleTransferRequestId', null) == null
        && request.resource.data.get('saleStatus', 'unsold') == 'unsold'
        && (request.resource.data.get('outcome', null) == null
            || request.resource.data.get('outcome', null) == 'listed')
        && request.resource.data.get('status', '') != 'sold'
        && request.resource.data.get('status', '') in [
             'rough', 'cut', 'heated', 'polished', 'ready_for_sale', 'listed'
           ]
        && request.resource.data.get('isListedOnMarketplace', false)
             == (request.resource.data.get('outcome', null) == 'listed')
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'status', 'stoneStage', 'custody', 'currentLocation',
               'outcome', 'isListedOnMarketplace', 'marketplaceListingId',
               'updatedAt'
             ]);
      allow delete: if isOwner(resource.data.ownerUid)
                    && isNotSuspended()
                    && resource.data.get('saleTransferRequestId', null) == null
                    && resource.data.get('saleStatus', 'unsold') != 'pending';
      allow create: if isAnySignedIn()
        && isOwner(request.resource.data.ownerUid);
      // An AP holder must be able to read a gem while it is locked on their AP
      // so the Taken AP detail can render the gem's photo and metadata.
      allow read: if isSignedIn() && isNotSuspended()
        && resource.data.currentApId is string
        && exists(/databases/$(database)/documents/gemtrack_ap_records/$(resource.data.currentApId))
        && (
          get(/databases/$(database)/documents/gemtrack_ap_records/$(resource.data.currentApId)).data.receiverUid == uid()
          || get(/databases/$(database)/documents/gemtrack_ap_records/$(resource.data.currentApId)).data.senderUid == uid()
          || get(/databases/$(database)/documents/gemtrack_ap_records/$(resource.data.currentApId)).data.ownerUid == uid()
        );
      // AP custody and sale transitions are coordinated by gemfortApi with
      // the AP record, so participants must not mutate the shared gem here.
      allow read, write: if isAdmin();
    }

    // Ownership transfer requests are created and resolved only by gemfortApi.
    // Both parties can read the request so the inbox/detail UI can reconcile it.
    match /gem_transfer_requests/{requestId} {
      allow read: if isSignedIn() && isNotSuspended()
        && (resource.data.sellerUid == uid()
            || resource.data.recipientUid == uid());
      allow write: if false;
      allow read, write: if isAdmin();
    }

    match /gemtrack_gem_costs/{docId} {
      allow read, write: if isOwner(resource.data.ownerUid)
                         && isNotSuspended();
      allow create: if isAnySignedIn()
        && isOwner(request.resource.data.ownerUid);
      allow read, write: if isAdmin();
    }

    match /gemtrack_gem_events/{docId} {
      allow read: if isOwner(resource.data.ownerUid);
      allow create: if isAnySignedIn()
        && isOwner(request.resource.data.ownerUid);
      // Events are immutable once created
      allow update: if false;
      allow delete: if isAdmin()
        || (isOwner(resource.data.ownerUid) && isNotSuspended());
      allow read, write: if isAdmin();
    }

    match /gemtrack_services/{docId} {
      allow read: if isNotSuspended()
        && (isOwner(resource.data.ownerUid)
            || (resource.data.providerUid is string
                && resource.data.providerUid == uid()));
      // Direct service records are owner-created. Business lapidary requests
      // are created by gemfortApi so gem locking and the request snapshot are
      // atomic; the client cannot manufacture a provider-side job.
      allow create: if isAnySignedIn()
        && isOwner(request.resource.data.ownerUid)
        && isNotSuspended()
        && (!('serviceKind' in request.resource.data)
            || request.resource.data.serviceKind != 'lapidary_request');
      // Owners can maintain their own records, but identities are immutable.
      // Provider actions go through gemfortApi so status changes and gem
      // custody changes happen together.
      allow update: if isOwner(resource.data.ownerUid)
        && isNotSuspended()
        && (!('serviceKind' in resource.data)
            || resource.data.serviceKind != 'lapidary_request')
        && (!('serviceKind' in request.resource.data)
            || request.resource.data.serviceKind != 'lapidary_request')
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.providerUid == resource.data.providerUid;
      allow delete: if isOwner(resource.data.ownerUid)
        && isNotSuspended()
        && (!('serviceKind' in resource.data)
            || resource.data.serviceKind != 'lapidary_request'
            || resource.data.status in ['rejected', 'cancelled', 'received_back', 'completed']);
      allow read, write: if isAdmin();
    }

    match /gemtrack_ap_records/{docId} {
      allow read: if isSignedIn() && isNotSuspended()
        && (resource.data.ownerUid == uid()
            || resource.data.senderUid == uid()
            || resource.data.receiverUid == uid());
      // Offline-first client creates (sender only, pending).
      allow create: if isAnySignedIn()
        && isNotSuspended()
        && request.resource.data.senderUid == uid()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.receiverUid is string
        && request.resource.data.receiverUid != uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;
      // AP state, custody, and deletion are coordinated atomically by
      // gemfortApi. Prevent direct participant edits from bypassing it.
      allow update, delete: if isAdmin();
      allow read, write: if isAdmin();
    }

    match /gemtrack_ap_payments/{docId} {
      allow read: if isSignedIn() && isNotSuspended()
        && (resource.data.senderUid == uid()
            || resource.data.receiverUid == uid()
            || resource.data.ownerUid == uid());
      // Payment records are written by gemfortApi together with AP state.
      allow create, update, delete: if isAdmin();
      allow read, write: if isAdmin();
    }

    match /gemtrack_cheques/{docId} {
      allow create: if isAnySignedIn()
        && isOwner(request.resource.data.ownerUid)
        && validCheque(request.resource.data);
      allow read: if isAdmin()
        || (isOwner(resource.data.ownerUid) && isNotSuspended());
      allow update: if isAdmin()
        || (isOwner(resource.data.ownerUid)
            && isNotSuspended()
            && request.resource.data.ownerUid == resource.data.ownerUid
            && validCheque(request.resource.data)
            && validChequeStatusTransition(resource.data.status, request.resource.data.status));
      allow delete: if isAdmin()
        || (isOwner(resource.data.ownerUid) && isNotSuspended());
    }

    match /gemtrack_bills/{docId} {
      // Owner-only personal tracking — never shared with contacts/counterparties.
      allow create: if isAnySignedIn()
        && isOwner(request.resource.data.ownerUid)
        && validBill(request.resource.data);
      allow read: if isAdmin()
        || (isOwner(resource.data.ownerUid) && isNotSuspended());
      allow update: if isAdmin()
        || (isOwner(resource.data.ownerUid)
            && isNotSuspended()
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.amountSettled >= resource.data.amountSettled
            && validBill(request.resource.data)
            && validBillStatusTransition(resource.data.status, request.resource.data.status));
      allow delete: if isAdmin()
        || (isOwner(resource.data.ownerUid) && isNotSuspended());
    }

    match /gemtrack_payments/{docId} {
      allow read, write: if isOwner(resource.data.ownerUid)
                         && isNotSuspended();
      allow create: if isAnySignedIn()
        && isOwner(request.resource.data.ownerUid);
      allow read, write: if isAdmin();
    }

    match /gemtrack_receivables/{docId} {
      allow read, write: if isOwner(resource.data.ownerUid)
                         && isNotSuspended();
      allow create: if isAnySignedIn()
        && isOwner(request.resource.data.ownerUid);
      allow read, write: if isAdmin();
    }

    match /gemtrack_payables/{docId} {
      allow read, write: if isOwner(resource.data.ownerUid)
                         && isNotSuspended();
      allow create: if isAnySignedIn()
        && isOwner(request.resource.data.ownerUid);
      allow read, write: if isAdmin();
    }

    match /gemtrack_transactions/{docId} {
      allow read, write: if isOwner(resource.data.ownerUid)
                         && isNotSuspended();
      allow create: if isAnySignedIn()
        && isOwner(request.resource.data.ownerUid);
      allow read, write: if isAdmin();
    }

    match /gemtrack_trips/{docId} {
      allow read, write: if isOwner(resource.data.ownerUid)
                         && isNotSuspended();
      allow create: if isAnySignedIn()
        && isOwner(request.resource.data.ownerUid);
      allow read, write: if isAdmin();
    }

    match /gemtrack_trip_expenses/{docId} {
      allow read, write: if isOwner(resource.data.ownerUid)
                         && isNotSuspended();
      allow create: if isAnySignedIn()
        && isOwner(request.resource.data.ownerUid);
      allow read, write: if isAdmin();
    }

    match /gemtrack_trip_gems/{docId} {
      allow read, write: if isOwner(resource.data.ownerUid)
                         && isNotSuspended();
      allow create: if isAnySignedIn()
        && isOwner(request.resource.data.ownerUid);
      allow read, write: if isAdmin();
    }

    match /gemtrack_contacts/{docId} {
      allow read, write: if isOwner(resource.data.ownerUid)
                         && isNotSuspended();
      allow create: if isAnySignedIn()
        && isOwner(request.resource.data.ownerUid);
      allow read, write: if isAdmin();
    }

    // ═══════════════════════════════════════════════
    // ENTERPRISE COLLECTIONS
    // ═══════════════════════════════════════════════

    match /companies/{companyId} {
      allow read: if isAdmin()
        || get(/databases/$(database)/documents/company_members/$(companyId + '_' + uid())).data.isActive == true;
      allow write: if isAdmin();
    }

    match /company_members/{memberId} {
      allow read: if isAdmin()
        || resource.data.userUid == uid();
      allow write: if isAdmin();
    }

    match /company_approvals/{approvalId} {
      allow read: if isAdmin()
        || resource.data.requestedByUid == uid()
        || resource.data.approverUid == uid();
      allow create: if isAnySignedIn()
        && request.resource.data.requestedByUid == uid();
      allow update: if isAdmin()
        || resource.data.approverUid == uid();
      allow delete: if isAdmin();
    }

    match /company_audit_logs/{logId} {
      allow read: if isAdmin()
        || get(/databases/$(database)/documents/company_members/$(resource.data.companyId + '_' + uid())).data.subRole in ['owner', 'manager'];
      // Audit entries are server/admin-owned and immutable.
      allow create: if isAdmin();
      // Immutable
      allow update: if false;
      allow delete: if false;
    }
  }
}
