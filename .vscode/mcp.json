{
  "servers": {
    "argent": {
      "type": "stdio",
      "command": "argent",
      "args": [
        "mcp"
      ]
    },
    "expo": {
      "type": "http",
      "url": "https://mcp.expo.dev/mcp"
    },
    "firebase": {
      "type": "stdio",
      "command": "firebase",
      "args": [
        "mcp"
      ],
      "cwd": "${workspaceFolder}"
    }
  }
}
